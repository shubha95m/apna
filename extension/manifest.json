{
  "manifest_version": 3,
  "name": "Apna — Personal & Family Workspace",
  "version": "1.0.0",
  "description": "Your Personal & Shared Workspace. One Account, All Devices, Always in Sync.",
  "permissions": [
    "storage",
    "notifications",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Apna Workspace"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

